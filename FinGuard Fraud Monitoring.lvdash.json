      "name": "country_breakdown",
      "displayName": "Country Breakdown",
      "config": {
        "version": "1.1",
        "source": "SELECT country, transaction_id, NULL AS alert_id, amount FROM finguard.silver.transactions UNION ALL SELECT transaction_country AS country, transaction_id, alert_id, amount FROM finguard.gold.fraud_card_alert UNION ALL SELECT country, transaction_id, alert_id, transaction_amount AS amount FROM finguard.gold.high_value_transactions_alert\n",
        "dimensions": [
          {
            "name": "country",
            "expr": "country"
          }
        ],
        "measures": [
          {
            "name": "transaction_count",
            "expr": "COUNT(DISTINCT transaction_id)"
          },
          {
            "name": "alert_count",
            "expr": "COUNT(DISTINCT alert_id)"
          },
          {
            "name": "total_amount",
            "expr": "SUM(amount)"
          }
        ]
      }
    },
    {
      "name": "risk_distribution",
      "displayName": "Risk Distribution",
      "config": {
        "version": "1.1",
        "source": "SELECT customer_id, \n  CASE WHEN risk_score >= 80 THEN 'High Risk' \n       WHEN risk_score >= 50 THEN 'Medium Risk' \n       ELSE 'Low Risk' END AS risk_category\nFROM finguard.silver.customers\n",
