{
  "datasets": [
    {
      "name": "all_fraud_alerts",
      "displayName": "All Fraud Alerts",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  alert_id, alert_type, alert_timestamp, transaction_id, customer_id, \n  customer_email, customer_name, amount AS transaction_amount, currency,\n  merchant_name, merchant_category, transaction_type, payment_channel,\n  transaction_city AS city, transaction_country AS country, is_international,\n  transaction_timestamp, transaction_status AS status, risk_level,\n  watchlist_id, watch_type\nFROM finguard.gold.fraud_card_alert UNION ALL SELECT \n  alert_id, alert_type, alert_timestamp, transaction_id, customer_id,\n  customer_email, customer_name, transaction_amount, currency,\n  merchant_name, merchant_category, transaction_type, payment_channel,\n  city, country, is_international, transaction_timestamp, status,\n  'HIGH' AS risk_level, NULL AS watchlist_id, NULL AS watch_type\nFROM finguard.gold.high_value_transactions_alert\n",
        "dimensions": [
          {
            "name": "alert_id",
            "expr": "alert_id"
          },
          {
            "name": "alert_type",
            "expr": "alert_type"
          },
          {
            "name": "alert_timestamp",
            "expr": "alert_timestamp"
          },
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "customer_name",
            "expr": "customer_name"
          },
          {
            "name": "customer_email",
            "expr": "customer_email"
          },
          {
            "name": "merchant_name",
            "expr": "merchant_name"
          },
          {
            "name": "merchant_category",
            "expr": "merchant_category"
          },
          {
            "name": "transaction_type",
            "expr": "transaction_type"
          },
          {
            "name": "payment_channel",
            "expr": "payment_channel"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "is_international",
            "expr": "is_international"
          },
          {
            "name": "status",
            "expr": "status"
          },
          {
            "name": "risk_level",
            "expr": "risk_level"
          },
          {
            "name": "watch_type",
            "expr": "watch_type"
          }
        ],
        "measures": [
          {
            "name": "total_alerts",
            "expr": "COUNT(DISTINCT alert_id)"
          },
          {
            "name": "total_transaction_amount",
            "expr": "SUM(transaction_amount)"
          },
          {
            "name": "avg_transaction_amount",
            "expr": "AVG(transaction_amount)"
          }
        ]
      }
    },
    {
      "name": "transaction_metrics",
      "displayName": "Transaction Metrics",
      "config": {
        "version": "1.1",
        "source": "finguard.silver.transactions",
        "dimensions": [
          {
            "name": "transaction_id",
            "expr": "transaction_id"
          },
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "merchant_name",
            "expr": "merchant_name"
          },
          {
            "name": "merchant_category",
            "expr": "merchant_category"
          },
          {
            "name": "transaction_type",
            "expr": "transaction_type"
          },
          {
            "name": "payment_channel",
            "expr": "payment_channel"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "is_international",
            "expr": "is_international"
          },
          {
            "name": "transaction_date",
            "expr": "DATE(transaction_timestamp)"
          },
          {
            "name": "transaction_timestamp",
            "expr": "transaction_timestamp"
          }
        ],
        "measures": [
          {
            "name": "total_transactions",
            "expr": "COUNT(DISTINCT transaction_id)"
          },
          {
            "name": "total_amount",
            "expr": "SUM(amount)"
          },
          {
            "name": "avg_amount",
            "expr": "AVG(amount)"
          }
        ]
      }
    },
    {
      "name": "customer_metrics",
      "displayName": "Customer Metrics",
      "config": {
        "version": "1.1",
        "source": "finguard.silver.customers",
        "dimensions": [
          {
            "name": "customer_id",
            "expr": "customer_id"
          },
          {
            "name": "customer_name",
            "expr": "CONCAT(first_name, ' ', last_name)"
          },
          {
            "name": "customer_segment",
            "expr": "customer_segment"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "risk_score",
            "expr": "risk_score"
          },
          {
            "name": "risk_category",
            "expr": "CASE WHEN risk_score >= 80 THEN 'High Risk' WHEN risk_score >= 50 THEN 'Medium Risk' ELSE 'Low Risk' END"
          }
        ],
        "measures": [
          {
            "name": "total_customers",
            "expr": "COUNT(DISTINCT customer_id)"
          },
          {
            "name": "high_risk_customers",
            "expr": "COUNT(DISTINCT CASE WHEN risk_score >= 80 THEN customer_id END)"
          },
          {
            "name": "avg_risk_score",
            "expr": "AVG(risk_score)"
          }
        ]
      }
    },
    {
      "name": "todays_alerts",
      "displayName": "Today's Alerts",
      "config": {
        "version": "1.1",
        "source": "SELECT \n  alert_id, alert_type, alert_timestamp, transaction_id, customer_id, \n  customer_email, customer_name, amount AS transaction_amount, currency,\n  merchant_name, merchant_category, transaction_type, payment_channel,\n  transaction_city AS city, transaction_country AS country, is_international,\n  transaction_timestamp, transaction_status AS status, risk_level\nFROM finguard.gold.fraud_card_alert WHERE DATE(alert_timestamp) = CURRENT_DATE() UNION ALL SELECT \n  alert_id, alert_type, alert_timestamp, transaction_id, customer_id,\n  customer_email, customer_name, transaction_amount, currency,\n  merchant_name, merchant_category, transaction_type, payment_channel,\n  city, country, is_international, transaction_timestamp, status,\n  'HIGH' AS risk_level\nFROM finguard.gold.high_value_transactions_alert WHERE DATE(alert_timestamp) = CURRENT_DATE()\n",
        "dimensions": [
          {
            "name": "alert_id",
            "expr": "alert_id"
          },
          {
            "name": "alert_type",
            "expr": "alert_type"
          },
          {
            "name": "customer_name",
            "expr": "customer_name"
          }
        ],
        "measures": [
          {
            "name": "total_alerts_today",
            "expr": "COUNT(DISTINCT alert_id)"
          }
        ]
      }
    },
    {
      "name": "watchlist_metrics",
      "displayName": "Watchlist Metrics",
      "config": {
        "version": "1.1",
        "source": "finguard.silver.fraud_watchlist",
        "dimensions": [
          {
            "name": "watchlist_id",
            "expr": "watchlist_id"
          },
          {
            "name": "watch_type",
            "expr": "watch_type"
          },
          {
            "name": "entity_id",
            "expr": "entity_id"
          },
          {
            "name": "risk_level",
            "expr": "risk_level"
          },
          {
            "name": "status",
            "expr": "status"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "reported_by",
            "expr": "reported_by"
          }
        ],
        "measures": [
          {
            "name": "total_watchlist_entries",
            "expr": "COUNT(DISTINCT watchlist_id)"
          },
          {
            "name": "active_entries",
            "expr": "COUNT(DISTINCT CASE WHEN status = 'ACTIVE' THEN watchlist_id END)"
          }
        ]
      }
    },
    {
      "name": "alert_trends",
      "displayName": "Alert Trends",
      "config": {
        "version": "1.1",
        "source": "SELECT alert_id, alert_type, alert_timestamp, risk_level FROM finguard.gold.fraud_card_alert UNION ALL SELECT alert_id, alert_type, alert_timestamp, 'HIGH' AS risk_level FROM finguard.gold.high_value_transactions_alert\n",
        "dimensions": [
          {
            "name": "alert_date",
            "expr": "DATE(alert_timestamp)"
          },
          {
            "name": "alert_hour",
            "expr": "HOUR(alert_timestamp)"
          },
          {
            "name": "alert_type",
            "expr": "alert_type"
          }
        ],
        "measures": [
          {
            "name": "alerts_count",
            "expr": "COUNT(DISTINCT alert_id)"
          }
        ]
      }
    },
